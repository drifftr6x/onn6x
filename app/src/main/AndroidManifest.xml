<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- Weather only (Open-Meteo). Everything else works offline. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Needed to list every installed app (Kodi, emulators, sideloaded apps...) -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Needed for the "Uninstall" action in the long-press menu -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Needed for the APK installer -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/app_logo"
        android:banner="@drawable/app_banner"
        android:label="onn6x Launcher"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Launcher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:stateNotNeeded="true"
            android:screenOrientation="landscape">

            <!-- Lets this app act as a home screen -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Lets you open it from Settings > Apps on a TV -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lets the system installer read APKs from this app's apks folder -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Optional: keeps the Home button pointed at this launcher while the stock one stays enabled -->
        <service
            android:name=".HomeOverrideService"
            android:exported="true"
            android:label="@string/home_override_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/home_override_service" />
        </service>

        <!-- Optional system screensaver: photos, clock and weather. Select it with ADB (see README). -->
        <service
            android:name=".OnnDreamService"
            android:exported="true"
            android:label="onn6x Screensaver"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
    </application>
</manifest>
